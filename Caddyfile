# Local dev config (AP6). Automatic TLS only arrives in AP8 with a real domain -
# deliberately plain HTTP on port 80 here for docker-compose.
#
# host.docker.internal works natively under Docker Desktop (Windows/Mac); extra_hosts
# in compose.yaml makes it portable under Linux Docker too.

:80 {
	@api path /api/*
	handle @api {
		reverse_proxy host.docker.internal:8080
	}

	# Public HLS renditions/thumbnails/sprite sheets: Caddy passes these through to storage
	# anonymously. "private/" does NOT go through here - the backend generates presigned URLs
	# for that.
	#
	# Garage has no S3 bucket-policy API (PutBucketPolicy always 501s, verified against
	# v1.0.1 - see garage/garage.toml and S3BucketInitializer#ensureBucketPublicReadPolicy).
	# Anonymous reads only work through its separate website endpoint (s3_web, port 3902),
	# which is vhost-routed by Host header with NO bucket segment in the request path -
	# unlike the plain path-style S3 endpoint MinIO used to serve this from. The garage-init
	# bootstrap (compose.yaml) enables website access for the bucket named below.
	@publicAssets path /public/*
	handle @publicAssets {
		# Renditions never change under an existing key: a re-transcode deletes the old
		# rendition rows and writes a fresh job, it doesn't overwrite these files in place.
		@segments path *.m4s *.mp4
		header @segments Cache-Control "public, immutable, max-age=31536000"

		# Thumbnails/sprite sheets DO change under the same key in place: the owner can
		# replace thumbnail_custom.jpg any time (9.4), and a re-transcode regenerates
		# thumbnail.jpg/sprite.jpg. A year-long immutable cache would make a browser that
		# already fetched the old image never see the new one. Short cache instead, same as
		# the playlists below (a blocked/deleted video shouldn't keep serving stale images
		# from the browser cache either, DSA notice procedure, AP7).
		@images path *.jpg
		header @images Cache-Control "public, max-age=300"

		@playlists path *.m3u8
		header @playlists Cache-Control "public, max-age=300"

		reverse_proxy garage:3902 {
			# Bucket name must match app.storage.bucket (application.properties) and
			# garage.toml's [s3_web] root_domain suffix.
			header_up Host {$STORAGE_BUCKET:video-service}.web.garage.localhost
		}
	}

	# "private/*" and everything else deliberately ends up here, not at the bucket - private
	# objects are only ever delivered via presigned backend URLs (delivery package).
	handle {
		respond 404
	}
}
