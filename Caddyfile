# Local dev config (AP6). Automatic TLS only arrives in AP8 with a real domain -
# deliberately plain HTTP on port 80 here for docker-compose.
#
# host.docker.internal works natively under Docker Desktop (Windows/Mac); extra_hosts
# in compose.yaml makes it portable under Linux Docker too.

:80 {
	@api path /api/*
	handle @api {
		reverse_proxy host.docker.internal:8080
	}

	# Public HLS renditions/thumbnails/sprite sheets: Caddy passes these through to the bucket
	# anonymously (see S3BucketInitializer#ensureBucketPublicReadPolicy for the required policy).
	# "private/" does NOT go through here - the backend generates presigned URLs for that.
	@publicAssets path /public/*
	handle @publicAssets {
		# Bucket name must match app.storage.bucket (application.properties).
		rewrite * /{$STORAGE_BUCKET:video-service}{uri}

		@segments path *.m4s *.mp4 *.jpg
		header @segments Cache-Control "public, immutable, max-age=31536000"

		# Shorter than the segments: a blocked/deleted playlist shouldn't keep being served
		# from the browser cache for a whole year (DSA notice procedure, AP7).
		@playlists path *.m3u8
		header @playlists Cache-Control "public, max-age=300"

		reverse_proxy minio:9000
	}

	# "private/*" and everything else deliberately ends up here, not at the bucket - private
	# objects are only ever delivered via presigned backend URLs (delivery package).
	handle {
		respond 404
	}
}
