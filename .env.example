# Copy to `.env` on the server, fill in real values, never commit the result.
# Variable names follow Spring Boot's relaxed binding (app.storage.access-key ->
# APP_STORAGE_ACCESS_KEY) - no code change needed to wire these in (CLAUDE.md §9.1).

# Which built image to run - set by the release workflow, or manually for a rollback
# (IMAGE_TAG=v1.2.2 docker compose -f compose.prod.yaml up -d).
IMAGE_TAG=latest

# --- Database (no default exists - spring-boot-docker-compose, which supplies this in dev, is
# developmentOnly and is not on the production classpath) ---
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/videoservice
SPRING_DATASOURCE_USERNAME=videoservice
SPRING_DATASOURCE_PASSWORD=changeme

# Consumed by the postgres image itself - keep these three in sync with the datasource values
# above (same database, same user).
POSTGRES_DB=videoservice
POSTGRES_USER=videoservice
POSTGRES_PASSWORD=changeme

# --- Object storage (Hetzner Object Storage in production, §2.1) ---
# With APP_STORAGE_PATH_STYLE_ACCESS=false, the AWS SDK builds the real request host itself by
# prepending the bucket as a subdomain (<bucket>.<endpoint-host>) - so this must be the bare
# LOCATION endpoint, not the bucket's own subdomain, or the bucket ends up duplicated
# (video-service.video-service.hel1...) and TLS hostname verification fails against Hetzner's
# wildcard cert (*.hel1.your-objectstorage.com). Found 2026-08-30 on the first real upload.
APP_STORAGE_ENDPOINT=https://<location>.your-objectstorage.com
APP_STORAGE_REGION=eu-central
APP_STORAGE_BUCKET=video-service
APP_STORAGE_ACCESS_KEY=changeme
APP_STORAGE_SECRET_KEY=changeme
# Verify against Hetzner Object Storage docs before relying on either value (§9.1).
APP_STORAGE_PATH_STYLE_ACCESS=false
APP_STORAGE_CORS_ALLOWED_ORIGINS=https://your-domain.example

# --- API ---
APP_API_CORS_ALLOWED_ORIGINS=https://your-domain.example

# --- Auth: persistent JWT signing key (see compose.prod.yaml / README) ---
APP_AUTH_JWT_PRIVATE_KEY_LOCATION=file:/secrets/jwt-private.pem
APP_AUTH_JWT_PUBLIC_KEY_LOCATION=file:/secrets/jwt-public.pem

# --- Caddy / TLS (infra/README.md, set once the domain is registered) ---
DOMAIN=your-domain.example
# Origin the browser fetches segments/thumbnails/playlists from directly (§9.3) - needed for the
# CSP header in Caddyfile.prod. Unlike APP_STORAGE_ENDPOINT above, this DOES include the bucket -
# it's the actual per-bucket URL the browser hits, not the SDK's endpoint-to-sign-requests-against.
STORAGE_PUBLIC_ORIGIN=https://<bucket-name>.<location>.your-objectstorage.com

# --- Backups (infra/README.md / infra/backup.sh) ---
STORAGEBOX_HOST=uXXXXXX.your-storagebox.de
STORAGEBOX_USER=uXXXXXX
